{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glances Dashboard",
  "version": "0.2.0",
  "identifier": "com.glancesdashboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run setup:skia-web && npx expo start",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Glances Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "transparent": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "George Tislenko",
    "homepage": "https://github.com/drumslave-git/glances-dashboard",
    "shortDescription": "A configurable dashboard for Glances system monitors.",
    "longDescription": "Point it at one or more machines running Glances, then build a board out of 26 purpose-built widgets: CPU traces and ring gauges, memory, load, per-core bars, network and disk throughput, filesystems, sensors, GPUs, process and container tables, and a cross-host alerts feed.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
