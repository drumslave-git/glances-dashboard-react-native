{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glances Dashboard",
  "version": "0.1.2",
  "identifier": "com.glancesdashboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run setup:skia-web && npx expo start",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Glances Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "transparent": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "George Tislenko",
    "homepage": "https://github.com/drumslave-git/glances-dashboard",
    "shortDescription": "A configurable dashboard for Glances system monitors.",
    "longDescription": "Point it at one or more Glances servers, then build a dashboard out of text, donut, pie, bar and process-list widgets.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
