{
  "name": "glances-dashboard-react-native",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "ios": "expo run:ios",
    "web": "npm run setup:skia-web && expo start --web",
    "build:web": "npm run setup:skia-web && expo export --platform web",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "setup:skia-web": "node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js public",
    "icons:web": "node scripts/make-pwa-icons.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "sync:version": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tamagui/config": "^2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/plugin-http": "^2.5.9",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.6.2",
    "victory-native": "^41.26.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  }
}
